# MISTRAL_API_KEY est OPTIONNELLE : sans elle, l'app démarre et chaque utilisateur
# saisit sa propre clé Mistral dans l'interface (stockée dans le navigateur, jamais
# sur le serveur). Si définie, elle sert de clé par défaut (fallback) pour tous.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optionnel : sur une instance exposée, force chaque utilisateur à fournir sa clé
# (désactive le fallback sur MISTRAL_API_KEY pour les requêtes IA).
# EUREKAI_REQUIRE_USER_KEY=true

# Optionnel : HTTPS local pour tablette/LAN (cf. scripts/gen-cert.sh). Débloque le
# chiffrement navigateur (WebCrypto/IndexedDB) hors localhost + chiffre la clé en transit.
# HTTPS_KEY=certs/key.pem
# HTTPS_CERT=certs/cert.pem

# Optional: only needed for CI/SonarCloud analysis, not required for running the app
SONAR_TOKEN=your_sonarcloud_token_here
