{
  "name": "eurekai",
  "version": "1.7.13",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n srv,web -c blue,green \"tsx watch server.ts\" \"vite\"",
    "dev:server": "tsx watch server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "lint:complexity": "./scripts/check-complexity.sh",
    "lint:deadcode": "knip",
    "typecheck": "tsc --noEmit",
    "security": "./scripts/check-security.sh",
    "pretest": "npm run typecheck && npm run lint:complexity && npm run lint:ci && npm run lint:deadcode",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,html,css,json}": "prettier --write",
    "*.{ts,js}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@lightpanda/browser": "^1.6.0",
    "@mistralai/mistralai": "^3.2.0",
    "@mozilla/readability": "^0.6.0",
    "alpinejs": "^3.17.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "linkedom": "^0.18.14",
    "lucide": "^1.61.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "vite-plugin-handlebars": {
      "vite": "$vite"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^5.0.0"
  }
}
